    "db:review-pilot": "tsx src/database/review-pilot-menus-cli.ts",
    "db:seed-batch-02": "tsx src/database/seed-batch-two-cli.ts",
    "db:review-batch-02": "tsx src/database/review-batch-two-cli.ts",
    "db:seed-batch-03": "tsx src/database/seed-batch-three-cli.ts",
    "db:review-batch-03": "tsx src/database/review-batch-three-cli.ts",
    "db:seed-batch-04": "tsx src/database/seed-batch-four-cli.ts",
    "db:review-batch-04": "tsx src/database/review-batch-four-cli.ts",
    "db:seed-batch-05": "tsx src/database/seed-batch-five-cli.ts",
    "db:review-batch-05": "tsx src/database/review-batch-five-cli.ts",
    "db:seed-batch-06": "tsx src/database/seed-batch-six-cli.ts",
    "db:review-batch-06": "tsx src/database/review-batch-six-cli.ts",
    "db:seed-batch-07": "tsx src/database/seed-batch-seven-cli.ts",
    "db:review-batch-07": "tsx src/database/review-batch-seven-cli.ts",
    "db:seed-batch-08": "tsx src/database/seed-batch-eight-cli.ts",
    "db:review-batch-08": "tsx src/database/review-batch-eight-cli.ts",
    "db:seed-batch-09": "tsx src/database/seed-batch-nine-cli.ts",
    "db:review-batch-09": "tsx src/database/review-batch-nine-cli.ts",
    "db:seed-batch-10": "tsx src/database/seed-batch-ten-cli.ts",
    "db:review-batch-10": "tsx src/database/review-batch-ten-cli.ts",
    "db:seed-batch-11": "tsx src/database/seed-batch-eleven-cli.ts",
    "db:review-batch-11": "tsx src/database/review-batch-eleven-cli.ts",
    "db:validate-foods": "tsx src/database/validate-food-catalog-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
