{
  "name": "ai-food-recommendation-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate-cli.ts",
    "db:import-tkpi": "tsx src/database/import-tkpi-cli.ts",
